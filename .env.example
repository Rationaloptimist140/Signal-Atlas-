# ───────────────────────── SIGNAL ATLAS — environment template ─────────────────────────
# Copy to backend/.env (API + worker) and set BACKEND_URL for the frontend. Never commit real values.

# --- core -------------------------------------------------------------------------------
APP_ENV=development                      # development | production
SECRET_KEY=                              # REQUIRED in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
DATABASE_URL=postgresql://signal:signal@localhost:5432/signal_atlas   # postgres:// URLs are converted to asyncpg automatically
FRONTEND_URL=http://localhost:3000       # public URL of the Next.js app (used for OAuth redirects)
CORS_ORIGINS=http://localhost:3000
# ENCRYPTION_KEY=                        # optional Fernet key for stored OAuth tokens; derived from SECRET_KEY when unset
# PLATFORM_ADMIN_EMAILS=you@example.com  # who may run instance-wide tools (demo fixtures, discovery) in production

# --- GitHub (read-only, public data) ----------------------------------------------------
# GITHUB_TOKEN=                          # optional: raises limits 60 -> 5,000 req/h and enables issue/PR totals. No scopes needed.
# GITHUB_OAUTH_CLIENT_ID=                # optional: "Sign in with GitHub" / connect account
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URL=             # defaults to {FRONTEND_URL}/api/v1/auth/github/callback

# --- AI enrichment (optional; reports work without it) ----------------------------------
LLM_PROVIDER=rules                       # rules | anthropic | openai
# LLM_MODEL=                             # e.g. claude-sonnet-4-5 or gpt-4o-mini
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint

# --- background jobs --------------------------------------------------------------------
JOBS_INLINE=false                        # true = run jobs inside the API process (local dev without a worker)
SYNC_INTERVAL_HOURS=24
DISCOVERY_ENABLED=true
# REDIS_URL=                             # optional: shared rate limiting when running more than one API instance

# --- email: verification and password reset ---------------------------------------------
EMAIL_PROVIDER=console                   # console (never delivers; dev prints links to the API log) | resend
# RESEND_API_KEY=                        # from resend.com (free tier is enough to start)
EMAIL_FROM=Signal Atlas <no-reply@mail.example.com>   # must be on a domain you have verified with the provider (DNS records)
# EMAIL_REPLY_TO=
EMAIL_VERIFICATION_REQUIRED=true         # soft gate: verify before reports, API keys and live GitHub requests

# --- billing: Stripe hosted checkout, TEST MODE ONLY in this release --------------------
BILLING_PROVIDER=manual                  # manual (no online checkout) | stripe
# STRIPE_SECRET_KEY=                     # sk_test_... only. A live key stops the API from starting.
# STRIPE_WEBHOOK_SECRET=                 # whsec_... for {FRONTEND_URL}/api/v1/billing/webhooks/stripe
BILLING_CURRENCY=gbp
BILLING_GRACE_DAYS=7                     # access kept this long after a failed renewal
# PLAN_OVERRIDES_JSON={"pro":{"price_gbp_month":19,"price_gbp_year":190}}   # change prices/limits without a code change

# --- product ----------------------------------------------------------------------------
SEED_DEMO_DATA=false                     # true = load fictional fixtures on first start of an empty database
ALLOW_REGISTRATION=true
ALLOW_SELF_SERVE_PLAN_CHANGE=false       # development only: switch plans without payment (refused in production)

# --- frontend (Next.js service) ---------------------------------------------------------
BACKEND_URL=http://localhost:8000        # private URL of the API; must be set at BUILD time as well as runtime
